# ── AI Agent ──────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use. Free options: google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct:free
# See https://openrouter.ai/models for the full list
OPENROUTER_MODEL=openai/gpt-4o-mini
# Fallback if primary is rate-limited, down, or out of tokens
OPENROUTER_MODEL_FALLBACK=meta-llama/llama-3.1-8b-instruct:free

# ── Supabase (Phase 8 — Owner CMS) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
